# Copie para .env.local e preencha. NUNCA commite chaves reais.

# --- Supabase ---------------------------------------------------------------
# Local: rode `npx supabase start` e copie os valores de `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (jobs, webhooks). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Login com Google (opcional) -------------------------------------------
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- IA (lib/ai) -------------------------------------------------------------
# mock = respostas falsas, sem custo (padrão em dev/testes). anthropic = real (Fase 1).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Embeddings (text-embedding-3-small, 1536 dim) e transcrição (Whisper)
OPENAI_API_KEY=
# Alternativa de embeddings
VOYAGE_API_KEY=

# --- Jobs ----------------------------------------------------------------------
# Segredo para chamar /api/jobs/process (cron)
JOBS_SECRET=

# --- Fase 4 --------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
