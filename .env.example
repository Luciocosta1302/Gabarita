# Copie para .env.local e preencha. NUNCA commite chaves reais.

# --- Supabase ---------------------------------------------------------------
# Local: rode `npx supabase start` e copie os valores de `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (jobs, webhooks). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Login com Google (opcional) -------------------------------------------
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- IA (lib/ai) -------------------------------------------------------------
# mock = respostas falsas, sem custo (padrão em dev/testes).
# gemini = Google Gemini para tudo (cota grátis, sem cartão; chave em aistudio.google.com).
# anthropic = Claude (geração) + OpenAI (embeddings/Whisper), pagos.
AI_PROVIDER=mock
GEMINI_API_KEY=
# opcionais (padrão: gemini-flash-lite-latest para tudo e gemini-embedding-001). O gemini-flash-latest
# gera melhor, mas na cota grátis demora 40-90 s por resposta.
GEMINI_MODEL_SMART=
GEMINI_MODEL_FAST=
GEMINI_MODEL_EMBED=
# reserva quando o principal está sobrecarregado (503); padrão gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=
ANTHROPIC_API_KEY=
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Embeddings (text-embedding-3-small, 1536 dim) e transcrição (Whisper)
OPENAI_API_KEY=
# Voyage NÃO serve por enquanto: não gera vetores de 1536 dimensões (o banco usa vector(1536)).
VOYAGE_API_KEY=

# --- Jobs ----------------------------------------------------------------------
# Segredo para o cron chamar /api/jobs/process (header "Authorization: Bearer <segredo>").
# Na Vercel, o Cron manda CRON_SECRET; qualquer um dos dois funciona.
JOBS_SECRET=
CRON_SECRET=

# SÓ testes: deixa ler links de endereços locais (127.0.0.1). Nunca ligue em produção (proteção contra SSRF).
LINK_FETCH_ALLOW_LOCAL=false

# Moderação da Comunidade (/moderacao): e-mails de quem modera, separados por vírgula
ADMIN_EMAILS=
# E-mail de contato mostrado na Política de privacidade (pedidos sobre dados, LGPD)
NEXT_PUBLIC_CONTACT_EMAIL=
# Conta de demonstração (login público no README): não pode ser apagada
DEMO_EMAIL=
